{
  "name": "drive-vault-sync",
  "version": "0.1.0",
  "description": "Two-way sync of an Obsidian vault with a Google Drive folder, on desktop and mobile.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test && node --test test-dist/plan.test.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/spark-md5": "^3.0.4",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  }
}
